// Zellij, for one reason only: the demo video captions itself.
//
// A tape can type keys and nothing else, so a caption has to be something a
// KEYSTROKE can set. `ctrl-q` here enters zellij's rename-pane mode; the words
// that follow are eaten by zellij and land in the tab bar, and the reviewer
// underneath never sees the key or the text. No second pane, no timers racing
// the beats, and nothing for `dfr` itself to know about.
//
// This file exists so the recording does not inherit the author's own zellij
// config. Passed with `--config`, which is all `assets/record.vhs` needs; do
// not add `--layout`, as zellij 0.45 panics on one under vhs.

show_startup_tips false
pane_frames true
simplified_ui false

// Cleared, so zellij intercepts exactly one key and passes every other one
// through to the reviewer. The reviewer already uses ctrl-d, ctrl-u, ctrl-c,
// ctrl-r, ctrl-n, ctrl-p, ctrl-s and ctrl-w; ctrl-q is free.
keybinds clear-defaults=true {
    normal {
        bind "Ctrl q" { SwitchToMode "renamepane"; PaneNameInput 0; }
    }
    renamepane {
        bind "Enter" { SwitchToMode "normal"; }
    }
}
