<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Flexoki Light, for differential's reviewer.

  Written for this crate from Flexoki's published palette values (Flexoki is
  by Steph Ango, MIT-licensed); the scope mapping is ours (ADR 0040).

  Ground #FFFCF0, text #100F0F, and Flexoki's 600 accents.
-->
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Flexoki Light (differential)</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key>
        <string>#FFFCF0</string>
        <key>foreground</key>
        <string>#100F0F</string>
        <key>caret</key>
        <string>#100F0F</string>
        <key>selection</key>
        <string>#DAD8CE</string>
        <key>lineHighlight</key>
        <string>#F2F0E5</string>
        <key>gutterForeground</key>
        <string>#6F6E69</string>
        <key>findHighlight</key>
        <string>#AD8301</string>
        <key>findHighlightForeground</key>
        <string>#FFFCF0</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Comment</string>
      <key>scope</key>
      <string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#B7B5AC</string>
        <key>fontStyle</key>
        <string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>String</string>
      <key>scope</key>
      <string>string, punctuation.definition.string</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#24837B</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Escape and regexp</string>
      <key>scope</key>
      <string>constant.character.escape, string.regexp</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#AD8301</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Number</string>
      <key>scope</key>
      <string>constant.numeric</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#5E409D</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Constant</string>
      <key>scope</key>
      <string>constant.language, constant.character, constant.other</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#AD8301</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Keyword</string>
      <key>scope</key>
      <string>keyword, keyword.control, storage.modifier, storage.type.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#66800B</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Operator</string>
      <key>scope</key>
      <string>keyword.operator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#6F6E69</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Storage type</string>
      <key>scope</key>
      <string>storage, storage.type</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#66800B</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Function</string>
      <key>scope</key>
      <string>entity.name.function, support.function, meta.function-call entity.name.function, variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#BC5215</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Type</string>
      <key>scope</key>
      <string>entity.name.type, entity.name.class, entity.name.struct, entity.name.enum, entity.name.trait, support.type, support.class, entity.other.inherited-class</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#AD8301</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Namespace</string>
      <key>scope</key>
      <string>entity.name.namespace, entity.name.module</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#AF3029</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Variable and property</string>
      <key>scope</key>
      <string>variable.other.member, variable.other.property, meta.property-name, support.type.property-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#205EA6</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Parameter</string>
      <key>scope</key>
      <string>variable.parameter</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#100F0F</string>
        <key>fontStyle</key>
        <string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Language variable</string>
      <key>scope</key>
      <string>variable.language</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#A02F6F</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Macro and attribute</string>
      <key>scope</key>
      <string>entity.name.macro, support.macro, meta.attribute, meta.annotation</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#A02F6F</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Punctuation</string>
      <key>scope</key>
      <string>punctuation.separator, punctuation.terminator, punctuation.accessor, punctuation.section</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#6F6E69</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Tag</string>
      <key>scope</key>
      <string>entity.name.tag</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#205EA6</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Attribute name</string>
      <key>scope</key>
      <string>entity.other.attribute-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#AD8301</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Heading</string>
      <key>scope</key>
      <string>markup.heading, entity.name.section</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#BC5215</string>
